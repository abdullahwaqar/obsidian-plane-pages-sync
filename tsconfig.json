{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "DOM",
            "ES2021"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "test/*.test.ts"
    ]
}
