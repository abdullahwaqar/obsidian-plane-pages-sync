{
    "name": "obsidian-plane-sync",
    "version": "1.1.1",
    "description": "Obsidian plugin that publish project folders as Plane pages and keep your Plane stickies in sync.",
    "keywords": [],
    "repository": {
        "type": "git",
        "url": "https://github.com/abdullahwaqar/obsidian-plane-sync.git"
    },
    "license": "MIT",
    "author": "Abdullah Waqar",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc && node esbuild.config.mjs production",
        "test": "node --experimental-strip-types --test test/*.test.ts && node scripts/test-sync.mjs",
        "lint": "biome check . && eslint .",
        "lint:fix": "biome check --write . && eslint --fix .",
        "format": "dprint fmt",
        "format:check": "dprint check",
        "check": "npm run format:check && npm run lint && tsc && npm test",
        "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
        "prepare": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "npx dprint fmt --staged && git add -u"
    },
    "dependencies": {
        "marked": "^18.1.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@dprint/json": "^0.25.2",
        "@dprint/typescript": "^0.96.1",
        "@eslint/js": "^9.39.5",
        "@eslint/json": "^0.14.0",
        "@types/node": "^26.6.5",
        "@types/turndown": "^5.0.6",
        "dprint": "^0.64.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "obsidian": "^1.14.4",
        "simple-git-hooks": "^2.14.0",
        "typescript": "~5.9",
        "typescript-eslint": "^8.72.0"
    }
}
